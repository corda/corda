# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JAVA-ORGJETBRAINSKOTLIN-2393744:
    - '*':
        reason: >-
          CVE-2020-29582: This vulnerability relates to information exposure via
          creation of temporary files (via Kotlin functions) with insecure
          permissions. Corda does not use any of the vulnerable functions so it
          not susceptible to this vulnerability.
        expires: 2029-08-01T01:00:00.000Z
        created: 2024-05-30T10:37:19.923Z
  SNYK-JAVA-ORGGRADLE-5750785:
    - '*':
        reason: >-
          CVE-2023-35947: This is a build-related vulnerability that does not
          affect the running of Corda. The Gradle build for Corda does not
          unpack any TAR archives. Corda is not exposed to this vulnerability.
        expires: 2029-08-01T01:00:00.000Z
        created: 2024-05-30T10:37:24.413Z
  SNYK-JAVA-COMFASTERXMLJACKSONCORE-15365924:
    - 'corda-project/tools/network-builder@4.12-SNAPSHOT > com.fasterxml.jackson.core:jackson-databind@2.19.2 > com.fasterxml.jackson.core:jackson-core@2.19.2':
        reason: >-
          CWE-770: This is an issue with FasterXML Jackson's handling of JSON
          documents containing inordinately large numbers. This is reported
          through the network-builder tool which is only used for testing. The
          expectation is that Corda tests are run in a securely-controlled
          environment, and so there should be no opportunity to exploit this
          issue.
